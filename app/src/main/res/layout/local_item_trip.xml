<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="trip"
            type="com.example.atomops.models.localtrips.Item" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/ivTruck"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_truck"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTripId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@{trip.trip_no}"
                    android:textColor="#1C2033"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/tvStatus"
                    app:layout_constraintStart_toEndOf="@id/ivTruck"
                    app:layout_constraintTop_toTopOf="@id/ivTruck"
                    tools:text="TRIP123456725" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@{trip.trip_date}"
                    android:textColor="#4A4F5C"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toEndOf="@id/tvTripId"
                    app:layout_constraintStart_toStartOf="@id/tvTripId"
                    app:layout_constraintTop_toBottomOf="@id/tvTripId"
                    tools:text="14-01-2025, 14:30" />

                <ImageView
                    android:id="@+id/ivMore"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_more_vert"
                    app:layout_constraintBottom_toBottomOf="@id/ivTruck"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/ivTruck"
                    app:tint="#1C2033" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_status_chip"
                    android:paddingStart="16dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="6dp"
                    android:text="@{trip.trip_status}"
                    android:textColor="#4B5BD6"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="@id/ivTruck"
                    app:layout_constraintEnd_toStartOf="@id/ivMore"
                    app:layout_constraintTop_toTopOf="@id/ivTruck"
                    tools:text="Created" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEF0F5" />

            <TextView
                android:id="@+id/tvRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="14dp"
                android:text="@{trip.route_name.toString()}"
                android:textColor="#1C2033"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold"
                tools:text="MUM-MHBI-006 → PUN-MHBI-007 → DEL-MHBI-008" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <TextView
                    style="@style/TripMeta"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_service"
                    android:text="@{trip.trip_type}"
                    tools:text="Service" />

                <TextView
                    style="@style/TripMeta"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_dock"
                    android:text="@{trip.dock_code}"
                    tools:text="Dock - 2A" />

                <TextView
                    style="@style/TripMeta"
                    android:layout_width="0dp"
                    android:layout_weight="1.1"
                    android:drawableStart="@drawable/ic_truck"
                    android:text="@{trip.vehicle_no}"
                    tools:text="DL14CC 1586" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
