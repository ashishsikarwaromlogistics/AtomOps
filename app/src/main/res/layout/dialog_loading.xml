<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_loading_dialog"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        >
        <ImageView

            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_outer_grey" />

        <ImageView
            android:id="@+id/ivOuterRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_outer_ring" />


        <ImageView
            android:id="@+id/ivInnerRing"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_inner_ring" />
        <ImageView

            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_gravity="center"
            />
        <ImageView
            android:id="@+id/ivCenterCore"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_center_core" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvLoadingText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Loading"
        android:textColor="#3F38B1"
        android:textSize="22sp"
        android:textStyle="bold" />

</LinearLayout>